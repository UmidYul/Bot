<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'ru' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — ' + t('app_name') : t('app_name') %></title>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <% if (typeof admin !== 'undefined' && admin) { %>
  <div class="topbar" id="topbar">
    <a href="/admin/users" class="brand"><span class="brand-dot"></span><%= t('app_name') %></a>
    <button type="button" class="menu-toggle" id="menuToggle" aria-label="Menu">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <div class="topbar-menu" id="topbarMenu">
      <nav>
        <a href="/admin/users" class="<%= typeof active !== 'undefined' && active === 'users' ? 'active' : '' %>"><%= t('nav_users') %></a>
        <a href="/admin/promo-codes" class="<%= typeof active !== 'undefined' && active === 'promo-codes' ? 'active' : '' %>"><%= t('nav_promo_codes') %></a>
        <a href="/admin/logs" class="<%= typeof active !== 'undefined' && active === 'logs' ? 'active' : '' %>"><%= t('nav_logs') %></a>
        <a href="/admin/broadcast" class="<%= typeof active !== 'undefined' && active === 'broadcast' ? 'active' : '' %>"><%= t('nav_broadcast') %></a>
        <a href="/admin/settings" class="<%= typeof active !== 'undefined' && active === 'settings' ? 'active' : '' %>"><%= t('nav_settings') %></a>
      </nav>
      <div class="topbar-right">
        <div class="lang-switch">
          <a href="/admin/lang/ru" class="<%= lang === 'ru' ? 'active' : '' %>">RU</a>
          <a href="/admin/lang/uz" class="<%= lang === 'uz' ? 'active' : '' %>">UZ</a>
        </div>
        <span class="admin-name"><%= admin.login %></span>
        <a href="/admin/logout" class="logout-link"><%= t('logout') %></a>
      </div>
    </div>
  </div>
  <% } %>
  <div class="container page-enter">
    <%- body %>
  </div>

  <div class="modal-backdrop" id="confirmModalBackdrop">
    <div class="modal-panel" role="alertdialog" aria-modal="true" aria-labelledby="confirmModalMessage" style="max-width:420px">
      <p id="confirmModalMessage" style="margin:0 0 20px;font-size:14.5px;line-height:1.5"></p>
      <div style="display:flex;gap:10px;justify-content:flex-end">
        <button type="button" class="btn" id="confirmModalCancel"><%= t('confirm_cancel') %></button>
        <button type="button" class="btn btn-danger" id="confirmModalOk"><%= t('confirm_ok') %></button>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var toggle = document.getElementById('menuToggle');
      var topbar = document.getElementById('topbar');
      if (toggle && topbar) {
        toggle.addEventListener('click', function () {
          topbar.classList.toggle('nav-open');
        });
      }
    })();

    /**
     * Замена нативного window.confirm() на попап в стиле остальной админки — браузерные
     * диалоги не поддаются кастомизации (нельзя даже поправить дизайн/шрифт) и на некоторых
     * платформах выглядят как "предупреждение", а не часть приложения.
     * Использование: либо <form data-confirm="Текст вопроса">, либо
     * window.AdminConfirm.open('Текст', function () { ...действие... }).
     */
    window.AdminConfirm = (function () {
      var backdrop = document.getElementById('confirmModalBackdrop');
      var messageEl = document.getElementById('confirmModalMessage');
      var okBtn = document.getElementById('confirmModalOk');
      var cancelBtn = document.getElementById('confirmModalCancel');
      var currentOnOk = null;

      function open(message, onOk) {
        messageEl.textContent = message;
        currentOnOk = onOk;
        backdrop.classList.add('open');
        okBtn.focus();
      }

      function close() {
        backdrop.classList.remove('open');
        currentOnOk = null;
      }

      okBtn.addEventListener('click', function () {
        var callback = currentOnOk;
        close();
        if (callback) callback();
      });
      cancelBtn.addEventListener('click', close);
      backdrop.addEventListener('click', function (e) {
        if (e.target === backdrop) close();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && backdrop.classList.contains('open')) close();
      });

      // Делегированный перехват форм с data-confirm — большинство подтверждений в
      // админке это одна и та же пара "форма + вопрос", без этого пришлось бы писать
      // одинаковый JS на каждой странице.
      document.addEventListener('submit', function (e) {
        var form = e.target;
        if (form instanceof HTMLFormElement && form.hasAttribute('data-confirm') && !form.dataset.confirmed) {
          e.preventDefault();
          open(form.getAttribute('data-confirm'), function () {
            form.dataset.confirmed = '1';
            if (form.requestSubmit) form.requestSubmit();
            else form.submit();
          });
        }
      });

      return { open: open, close: close };
    })();
  </script>
</body>
</html>
