<div class="page-back"><a href="/admin/users" class="btn btn-sm"><%= t('user_detail_back') %></a></div>
<h1><%= t('user_detail_title', user.code) %></h1>

<% if (flash) { %>
  <div class="flash flash-success"><%= flash %></div>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="flash flash-error"><%= error %></div>
<% } %>

<div class="tabs-nav">
  <button class="tab-btn active" data-tab="profile" type="button"><%= t('tab_profile') %></button>
  <button class="tab-btn" data-tab="payments" type="button"><%= t('tab_payments') %> (<%= payments.length %>)</button>
  <button class="tab-btn" data-tab="activity" type="button"><%= t('tab_activity') %> (<%= activity.length %>)</button>
</div>

<div class="tab-panel" data-panel="profile">
  <div class="card">
    <div class="grid-2">
      <div><span class="muted"><%= t('field_telegram_id') %></span><br><%= user.telegram_id %></div>
      <div><span class="muted"><%= t('field_username') %></span><br><%= user.username ? '@' + user.username : '—' %></div>
      <div><span class="muted"><%= t('field_phone') %></span><br><%= user.phone || '—' %></div>
      <div><span class="muted"><%= t('field_language') %></span><br><%= user.language %></div>
      <div>
        <span class="muted"><%= t('field_status') %></span><br>
        <span class="badge badge-<%= user.status %>"><%= t('status_' + user.status) %></span>
        <% if (user.blocked_at) { %><span class="badge badge-blocked"><%= t('status_blocked') %></span><% } %>
      </div>
      <div><span class="muted"><%= t('field_registered') %></span><br><%= new Date(user.created_at).toLocaleString('ru-RU') %></div>
      <% if (user.blocked_at) { %>
        <div><span class="muted"><%= t('field_blocked_since') %></span><br><%= new Date(user.blocked_at).toLocaleString('ru-RU') %></div>
      <% } %>
      <% if (user.deleted_at) { %>
        <div><span class="muted"><%= t('field_deleted_since') %></span><br><%= new Date(user.deleted_at).toLocaleString('ru-RU') %></div>
      <% } %>
    </div>

    <div class="actions" style="margin-top:20px">
      <% if (user.blocked_at) { %>
        <form method="POST" action="/admin/users/<%= user.id %>/unblock">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-primary"><%= t('btn_unblock') %></button>
        </form>
      <% } else { %>
        <form method="POST" action="/admin/users/<%= user.id %>/block" data-confirm="<%= t('confirm_block') %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-danger"><%= t('btn_block') %></button>
        </form>
      <% } %>

      <% if (user.deleted_at) { %>
        <form method="POST" action="/admin/users/<%= user.id %>/restore">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-primary"><%= t('btn_restore') %></button>
        </form>
      <% } else { %>
        <form method="POST" action="/admin/users/<%= user.id %>/delete" data-confirm="<%= t('confirm_delete') %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-danger"><%= t('btn_delete') %></button>
        </form>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-section-title" style="margin-bottom:12px"><%= t('section_status_override') %></div>
    <p class="field-hint" style="margin-top:0"><%= t('status_override_hint') %></p>
    <form method="POST" action="/admin/users/<%= user.id %>/status" class="status-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <select name="status">
        <% ['new','pending','paid'].forEach(function (s) { %>
          <option value="<%= s %>" <%= user.status === s ? 'selected' : '' %>><%= t('status_' + s) %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn-sm"><%= t('btn_change_user_status') %></button>
    </form>
  </div>
</div>

<div class="tab-panel" data-panel="payments" hidden>
  <div class="card" style="padding:0">
    <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th><%= t('payments_col_date') %></th>
          <th><%= t('payments_col_provider') %></th>
          <th><%= t('payments_col_amount') %></th>
          <th><%= t('payments_col_status') %></th>
          <th><%= t('payments_col_promo') %></th>
          <th><%= t('payments_col_change_status') %></th>
        </tr>
      </thead>
      <tbody>
        <% payments.forEach(function (p) { %>
          <tr>
            <td data-label="<%= t('payments_col_date') %>"><%= new Date(p.created_at).toLocaleString('ru-RU') %></td>
            <td data-label="<%= t('payments_col_provider') %>"><%= p.provider %></td>
            <td data-label="<%= t('payments_col_amount') %>"><%= Number(p.amount).toLocaleString('ru-RU') %> <%= p.currency %></td>
            <td data-label="<%= t('payments_col_status') %>"><span class="badge badge-<%= p.status %>"><%= p.status %></span></td>
            <td data-label="<%= t('payments_col_promo') %>"><%= p.promo_code || '—' %></td>
            <td data-label="<%= t('payments_col_change_status') %>">
              <form method="POST" action="/admin/payments/<%= p.id %>/status" class="status-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <select name="status">
                  <% ['pending','paid','failed'].forEach(function (s) { %>
                    <option value="<%= s %>" <%= p.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
                <button type="submit" class="btn btn-sm"><%= t('btn_save') %></button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (!payments.length) { %>
          <tr><td colspan="6" class="empty-state no-stack"><%= t('payments_empty') %></td></tr>
        <% } %>
      </tbody>
    </table>
    </div>
  </div>
</div>

<div class="tab-panel" data-panel="activity" hidden>
  <div class="card" style="padding:0">
    <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th><%= t('logs_col_date') %></th>
          <th><%= t('logs_col_admin') %></th>
          <th><%= t('logs_col_action') %></th>
          <th><%= t('logs_col_details') %></th>
        </tr>
      </thead>
      <tbody>
        <% activity.forEach(function (l) { %>
          <tr>
            <td data-label="<%= t('logs_col_date') %>"><%= new Date(l.created_at).toLocaleString('ru-RU') %></td>
            <td data-label="<%= t('logs_col_admin') %>"><%= l.admin_login || t('logs_system') %></td>
            <td data-label="<%= t('logs_col_action') %>"><%= l.action %></td>
            <td data-label="<%= t('logs_col_details') %>" class="faint"><%= l.meta ? JSON.stringify(l.meta) : '' %></td>
          </tr>
        <% }) %>
        <% if (!activity.length) { %>
          <tr><td colspan="4" class="empty-state no-stack"><%= t('activity_empty') %></td></tr>
        <% } %>
      </tbody>
    </table>
    </div>
  </div>
</div>

<script>
  (function () {
    var btns = Array.prototype.slice.call(document.querySelectorAll('.tab-btn'));
    var panels = Array.prototype.slice.call(document.querySelectorAll('.tab-panel'));
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        btns.forEach(function (b) { b.classList.remove('active'); });
        panels.forEach(function (p) { p.hidden = true; });
        btn.classList.add('active');
        var target = document.querySelector('.tab-panel[data-panel="' + btn.dataset.tab + '"]');
        if (target) target.hidden = false;
      });
    });
  })();

  (function () {
    // Обе формы смены статуса (юзера и конкретного платежа) — обход автоматической логики
    // оплаты/баланса вручную, стоит переспросить перед отправкой. Текст подтверждения строим
    // динамически по выбранному в <select> значению, а не статичным data-confirm, как у
    // block/delete — здесь важно показать, на какой именно статус меняем.
    var template = <%- JSON.stringify(t('confirm_status_change', '__VALUE__')) %>;
    Array.prototype.slice.call(document.querySelectorAll('.status-form')).forEach(function (form) {
      form.addEventListener('submit', function (e) {
        if (form.dataset.confirmed) return;
        e.preventDefault();

        var select = form.querySelector('select[name="status"]');
        var label = select.options[select.selectedIndex].text;
        var message = template.replace('__VALUE__', label);

        window.AdminConfirm.open(message, function () {
          form.dataset.confirmed = '1';
          if (form.requestSubmit) form.requestSubmit();
          else form.submit();
        });
      });
    });
  })();
</script>
