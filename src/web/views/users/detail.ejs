<p><a href="/admin/users">&larr; Все пользователи</a></p>
<h1>Пользователь <%= user.code %></h1>

<% if (flash) { %>
  <div class="flash flash-success"><%= flash %></div>
<% } %>

<div class="card">
  <div class="grid-2">
    <div><span class="muted">Telegram ID</span><br><%= user.telegram_id %></div>
    <div><span class="muted">Username</span><br><%= user.username ? '@' + user.username : '—' %></div>
    <div><span class="muted">Телефон</span><br><%= user.phone || '—' %></div>
    <div><span class="muted">Язык</span><br><%= user.language %></div>
    <div><span class="muted">Статус</span><br><span class="badge badge-<%= user.status %>"><%= user.status %></span></div>
    <div><span class="muted">Регистрация</span><br><%= new Date(user.created_at).toLocaleString('ru-RU') %></div>
  </div>

  <div class="actions" style="margin-top:16px">
    <% if (user.status === 'blocked') { %>
      <form method="POST" action="/admin/users/<%= user.id %>/unblock">
        <button type="submit" class="btn btn-primary">Разблокировать</button>
      </form>
    <% } else { %>
      <form method="POST" action="/admin/users/<%= user.id %>/block" onsubmit="return confirm('Заблокировать пользователя?');">
        <button type="submit" class="btn btn-danger">Заблокировать</button>
      </form>
    <% } %>
  </div>
</div>

<h2>История платежей</h2>
<div class="card">
  <table>
    <thead>
      <tr>
        <th>Дата</th>
        <th>Провайдер</th>
        <th>Сумма</th>
        <th>Статус</th>
        <th>Промокод</th>
        <th>Изменить статус</th>
      </tr>
    </thead>
    <tbody>
      <% payments.forEach(function (p) { %>
        <tr>
          <td><%= new Date(p.created_at).toLocaleString('ru-RU') %></td>
          <td><%= p.provider %></td>
          <td><%= p.amount %> <%= p.currency %></td>
          <td><span class="badge badge-<%= p.status %>"><%= p.status %></span></td>
          <td><%= p.promo_code || '—' %></td>
          <td>
            <form method="POST" action="/admin/payments/<%= p.id %>/status" style="display:flex;gap:6px">
              <select name="status">
                <% ['pending','paid','failed'].forEach(function (s) { %>
                  <option value="<%= s %>" <%= p.status === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
              <button type="submit" class="btn btn-sm">Сохранить</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!payments.length) { %>
        <tr><td colspan="6" class="muted">Платежей ещё нет</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
