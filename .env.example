# === Telegram ===
# Токен бота от @BotFather
BOT_TOKEN=

# Публичный HTTPS-домен, на котором висит Express (без слэша в конце).
# Telegram/Click/Payme будут стучаться сюда: ${WEB_BASE_URL}/telegram/webhook и т.д.
WEB_BASE_URL=https://example.com

# ID закрытого канала (число со знаком минус, вида -1001234567890)
CHANNEL_ID=

# Постоянная invite-ссылка с creates_join_request: true (создаётся один раз, см. README)
CHANNEL_INVITE_LINK=

# Цена доступа к каналу в сумах (UZS)
CHANNEL_PRICE=100000

# === Сервер ===
PORT=3000
NODE_ENV=development

# === База данных ===
# Локально (по умолчанию Postgres слушает 5432, пользователь postgres)
DATABASE_URL=postgres://postgres:admin@localhost:5432/tg_sub_bot

# === Сессии (админка) ===
SESSION_SECRET=change-me-to-a-long-random-string

# === Click (Shop API — вебхуки для оплаты вручную через приложение Click по коду юзера) ===
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# provider_token из BotFather (/mybots -> Payments -> подключить Click) — для встроенной
# оплаты прямо в боте (sendInvoice). Формат вида "123456:TEST:xxxxx" (тест) или "123456:LIVE:xxxxx" (прод).
CLICK_PROVIDER_TOKEN=

# === Payme (Merchant API) ===
# Кнопка Payme скрыта из бота, пока не true (см. src/config.js) — сам вебхук остаётся рабочим.
PAYME_ENABLED=false
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_KEY=

# === Первый admin-аккаунт (создаётся сидом) ===
ADMIN_SEED_LOGIN=admin
ADMIN_SEED_PASSWORD=change-me

# === Уведомления админам в Telegram ===
# Telegram user id через запятую (узнать свой можно у @userinfobot). Бот шлёт сюда:
# новую успешную оплату, всплеск неверных промокодов, необработанные ошибки бота.
# Пусто = уведомления не отправляются.
ADMIN_NOTIFY_CHAT_IDS=

# === Антиспам на ввод промокода ===
# После скольких подряд неверных попыток блокировать ввод промокода и на сколько минут.
PROMO_MAX_ATTEMPTS=5
PROMO_LOCKOUT_MINUTES=15

# === Бэкапы Postgres (npm run backup, см. scripts/backup.js) ===
# Путь к pg_dump. На Linux VPS с установленным postgresql-client обычно достаточно "pg_dump"
# (уже в PATH). На Windows-деве укажи полный путь, например:
# C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
PG_DUMP_PATH=pg_dump
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=backups
